# ==========================================
# ENVIRONMENT VARIABLES - EXEMPEL
# ==========================================
# 
# Kopiera denna fil till .env (läggs INTE till Git!)
# Fyll i dina egna värden
#
# VIKTIGT: .env ska ALDRIG commitas till Git!
# Lägg till .env i .gitignore
# ==========================================

# =========================
# JWT CONFIGURATION
# =========================

# JWT Secret Key - MÅSTE vara samma för Gateway och UserService
# Minst 256 bits (32 characters) för HS256 algoritm
# Generera en säker secret: https://randomkeygen.com/ eller PowerShell: 
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=mySecretKey123456789012345678901234567890

# JWT Expiration i millisekunder (default: 24 timmar)
JWT_EXPIRATION=86400000

# =========================
# DATABAS CONFIGURATION
# =========================

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trafficschool
DB_USERNAME=root
DB_PASSWORD=yourpassword

# =========================
# SWISH API (PaymentService)
# =========================

# Swish Test Environment
SWISH_PAYMENT_URL=https://mss.cpc.getswish.net/swish-cpcapi/api/v2/paymentrequests
SWISH_CALLBACK_URL=http://localhost:8080/api/swish/callback
SWISH_PAYEE_NUMBER=1234679304

# =========================
# EMAIL SERVICE
# =========================

# SMTP Configuration (för magic link)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@trafficschool.se

# =========================
# PORTAR (optional - defaults finns i application.properties)
# =========================

# Eureka Server
# EUREKA_PORT=8761

# Microservices
# GATEWAY_PORT=8080
# USER_SERVICE_PORT=8081
# QUIZ_SERVICE_PORT=8082
# EXAM_SERVICE_PORT=8083
# ADMIN_SERVICE_PORT=8084
# PAYMENT_SERVICE_PORT=8085
